[debug] [2026-05-13T10:43:35.821Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kool-clicker/rulesets {"name":"projects/kool-clicker/rulesets/b6ba556c-9cf5-4e1f-b5b7-8a4b03f5001c","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function currentRole() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role\n        : signedIn()\n        && exists(/databases/$(database)/documents/userAuthIndex/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/userAuthIndex/$(request.auth.uid)).data.role\n        : null;\n    }\n\n    function isClicker() {\n      return currentRole() == \"clicker\"\n        || exists(/databases/$(database)/documents/clickers/$(request.auth.uid));\n    }\n\n    function isCashier() {\n      return currentRole() == \"cashier\";\n    }\n\n    function isManager() {\n      return currentRole() == \"manager\";\n    }\n\n    function isSuperAdmin() {\n      return currentRole() == \"superAdmin\";\n    }\n\n    function cashierRestaurantId() {\n      return isCashier()\n        && exists(/databases/$(database)/documents/cashiers/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/cashiers/$(request.auth.uid)).data.restaurantId\n        : null;\n    }\n\n    function managerRestaurantId() {\n      return isManager()\n        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))\n        ? get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.restaurantId\n        : null;\n    }\n\n    function onlyChanged(allowedKeys) {\n      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedKeys);\n    }\n\n    function validOrderStatus(status) {\n      return status in [\"Pending\", \"Preparing\", \"Ready\", \"Collected\", \"Cancelled\"];\n    }\n\n    function validCashierProgressStatus(status) {\n      return status in [\"Pending\", \"Preparing\", \"Ready\"];\n    }\n\n    function validPaymentMethod(method) {\n      return method in [\"CashOnDelivery\", \"InstaPay\"];\n    }\n\n    match /userAuthIndex/{uid} {\n      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());\n      allow write: if false;\n    }\n\n    match /users/{uid} {\n      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());\n      allow write: if false;\n    }\n\n    match /clickers/{uid} {\n      allow create: if signedIn()\n        && request.auth.uid == uid\n        && request.resource.data.role == \"clicker\"\n        && request.resource.data.authUid == uid;\n      allow read: if signedIn() && (request.auth.uid == uid || isManager() || isSuperAdmin());\n      allow update: if signedIn()\n        && (\n          (request.auth.uid == uid\n            && resource.data.authUid == uid\n            && request.resource.data.authUid == resource.data.authUid\n            && request.resource.data.role == \"clicker\"\n            && onlyChanged([\"username\", \"updatedAt\"]))\n        );\n      allow delete: if false;\n    }\n\n    match /clickerIndex/{key} {\n      allow get: if true;\n      allow list: if false;\n      allow create: if\n        (!signedIn()\n          && request.resource.data.keys().hasOnly([\"reserved\", \"reservedAt\"])\n          && request.resource.data.reserved == true)\n        || (signedIn()\n          && request.resource.data.uid == request.auth.uid\n          && request.resource.data.keys().hasOnly([\"uid\", \"authEmail\", \"linkedAt\"]));\n      allow update: if signedIn()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.keys().hasOnly([\"uid\", \"authEmail\", \"linkedAt\"]);\n      allow delete: if signedIn()\n        && resource.data.uid == request.auth.uid;\n    }\n\n    match /cashiers/{uid} {\n      allow read: if signedIn() && (request.auth.uid == uid || isManager() || isSuperAdmin());\n      allow write: if false;\n    }\n\n    match /managers/{uid} {\n      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());\n      allow write: if false;\n    }\n\n    match /kc_restaurants/{restaurantId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /products/{productId} {\n      allow read: if true;\n      allow create: if isManager()\n        && request.resource.data.restaurantId == managerRestaurantId();\n      allow update: if isManager()\n        && resource.data.restaurantId == managerRestaurantId()\n        && request.resource.data.restaurantId == resource.data.restaurantId;\n      allow delete: if isManager()\n        && resource.data.restaurantId == managerRestaurantId();\n    }\n\n    match /offers/{offerId} {\n      allow read: if true;\n      allow create: if isManager()\n        && request.resource.data.restaurantId == managerRestaurantId();\n      allow update: if isManager()\n        && resource.data.restaurantId == managerRestaurantId()\n        && request.resource.data.restaurantId == resource.data.restaurantId;\n      allow delete: if isManager()\n        && resource.data.restaurantId == managerRestaurantId();\n    }\n\n    match /promoCodes/{promoId} {\n      allow read: if signedIn();\n      allow create: if isManager()\n        && request.resource.data.restaurantId == managerRestaurantId();\n      allow update: if isManager()\n        && resource.data.restaurantId == managerRestaurantId()\n        && request.resource.data.restaurantId == resource.data.restaurantId;\n      allow delete: if isManager()\n        && resource.data.restaurantId == managerRestaurantId();\n    }\n\n    match /orders/{orderId} {\n      allow read: if signedIn()\n        && (\n          (isClicker() && resource.data.clickerUid == request.auth.uid)\n          || (isCashier() && resource.data.restaurantId == cashierRestaurantId())\n          || (isManager() && resource.data.restaurantId == managerRestaurantId())\n          || isSuperAdmin()\n        );\n\n      allow create: if false;\n\n      allow update: if signedIn()\n        && isCashier()\n        && resource.data.restaurantId == cashierRestaurantId()\n        && (\n          (validCashierProgressStatus(resource.data.status)\n            && validCashierProgressStatus(request.resource.data.status)\n            && onlyChanged([\"status\", \"statusHistory\", \"remainingTimeMinutes\", \"updatedAt\"]))\n          || (resource.data.status != \"Cancelled\"\n            && request.resource.data.paymentStatus == \"Confirmed\"\n            && onlyChanged([\"paymentStatus\", \"updatedAt\"]))\n        );\n\n      allow delete: if false;\n    }\n\n    match /auditLogs/{logId} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /deletedUsers/{uid} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /orderRequests/{requestId} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /orderRateLimits/{uid} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /adminRateLimits/{rateId} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /opsMetrics/{metricId} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /systemHealth/{healthId} {\n      allow read: if isSuperAdmin();\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"backend/firebase-rules/firestore.rules"}]},"createTime":"2026-05-13T10:43:35.701151Z","metadata":{"services":["cloud.firestore"]}}
