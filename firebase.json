{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "backend/firebase-rules/firestore.rules",
    "indexes": "backend/firebase-rules/firestore.indexes.json"
  },
  "functions": {
    "source": "backend/cloud-functions"
  }
}
